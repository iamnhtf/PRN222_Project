@model IEnumerable<zCoach.Entities.ThaiNH.Models.CoachThaiNh>

@{
    ViewData["Title"] = "Coach Roster";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-primary fw-bold">🏋️‍♂️ Coach Roster</h2>
    <a asp-action="Create" class="btn btn-success">
        <i class="bi bi-plus-circle"></i> Add New Coach
    </a>
</div>

<div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
    @foreach (var item in Model) {
        <div class="col">
            <div class="card h-100 shadow-sm border-0 rounded-3 overflow-hidden position-relative">
                <span class="position-absolute top-0 end-0 badge bg-secondary m-2 rounded-pill">ID: @item.CoachThaiNhid</span>
                <div class="bg-light text-center p-3">
                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://cdn-icons-png.flaticon.com/512/3135/3135715.png" : item.ImageUrl)" 
                         class="rounded-circle object-fit-cover shadow-sm" 
                         style="width: 120px; height: 120px;" 
                         alt="Coach Image">
                </div>
                <div class="card-body text-center">
                    <h5 class="card-title fw-bold text-dark mb-1">@item.FullName</h5>
                    <span class="badge bg-primary mb-3">@(item.SpecializationThaiNh?.SpecializationName ?? "General")</span>
                    
                    <ul class="list-unstyled text-start small mb-0">
                        <li class="mb-1"><strong class="text-muted">Exp:</strong> @(string.IsNullOrEmpty(item.Experience) ? "N/A" : item.Experience)</li>
                        <li class="mb-1"><strong class="text-muted">Phone:</strong> @item.Phone</li>
                        <li class="mb-1 text-truncate"><strong class="text-muted">Email:</strong> @item.Email</li>
                    </ul>
                </div>
                <div class="card-footer bg-white border-top-0 d-flex justify-content-center gap-2 pb-3">
                    <a asp-action="Edit" asp-route-id="@item.CoachThaiNhid" class="btn btn-sm btn-outline-primary px-3">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.CoachThaiNhid" class="btn btn-sm btn-outline-info px-3">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.CoachThaiNhid" class="btn btn-sm btn-outline-danger px-3">Delete</a>
                </div>
            </div>
        </div>
    }
</div>
